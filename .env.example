# Copy to apps/web/.env.local for `npm run dev`.
# Names only. Never commit real tokens.

# Experto identity. Leave EXPERTO_IDENTITY_URL empty in v0 to run without a login screen.
# When it is set, the server checks the Experto session cookie and will not fake a pass.
EXPERTO_IDENTITY_URL=
EXPERTO_IDENTITY_AUDIENCE=experto-intent-hub
EXPERTO_SESSION_COOKIE_NAME=experto_session
EXPERTO_SERVICE_TOKEN=
EXPERTO_API_TIMEOUT_MS=8000

# Studio is the first wired backend. Empty URL = honest local stub (status "stub", not "ready").
# Marketeer uses the same rule.
STUDIO_API_BASE_URL=
MARKETER_API_BASE_URL=
